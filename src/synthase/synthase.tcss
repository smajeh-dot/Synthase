/* The app's look. Every colour is a token from theme.py; nothing is styled in
   Python. Save this file while `textual run --dev synthase.app:SynthaseApp` is
   running and the open app updates. Design: docs/decisions/0016. */

Screen {
    background: $background;
    color: $foreground;
}

/* Output area */
#output {
    height: 1fr;
    padding: 0 1;
    background: $background;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-background: $track;
    scrollbar-background-hover: $track;
    scrollbar-background-active: $track;
    scrollbar-color: $thumb;
    scrollbar-color-hover: $muted;
    scrollbar-color-active: $foreground;
}

/* Messages: one widget each. .glyph is the 2-cell symbol column, so wrapped
   lines hang under the text. */
.msg { width: 1fr; height: auto; }
.msg.-reply { padding-left: 2; }
.msg > .glyph { width: 2; height: auto; }
.msg > .body { width: 1fr; height: auto; }

.msg.-welcome > .lead { width: auto; color: $echo; text-style: bold; }
.msg.-welcome > .body { color: $muted; }

.msg.-echo { margin-top: 1; }
.msg.-echo > .glyph { color: $accent; text-style: bold; }
.msg.-echo > .body { color: $echo; text-style: bold; }

.msg.-normal > .body { color: $foreground; }

.msg.-success > .glyph { color: $success; text-style: bold; }
.msg.-success > .body { color: $success; }

.msg.-hint > .glyph, .msg.-hint > .body { color: $muted; }
.msg.-cancel > .glyph, .msg.-cancel > .body { color: $muted; }

.msg.-caution > .glyph { color: $caution; text-style: bold; }
.msg.-caution > .body { color: $caution; }

.msg.-warning > .glyph { color: $warning; text-style: bold; }
.msg.-warning > .body { color: $warning; }

.msg.-error > .glyph { color: $error; text-style: bold; }
.msg.-error > .body { color: $error; }

/* /help pages: paragraphs, then names in one column and their help in the next,
   wrapping under itself. A blank row between the parts. */
.msg.-help > .body > * { height: auto; margin-top: 1; }
.msg.-help > .body > *:first-child { margin-top: 0; }
.msg.-help .rows {
    grid-size: 2;
    grid-columns: auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 2;
}
.msg.-help .rows > * { height: auto; }

/* /doctor: the heading, then each check's word and text in two columns; the
   unverified values; the last line. The word carries the meaning, colour only
   helps. A blank row between the parts. */
.msg.-doctor > .body > .heading { height: auto; color: $heading; text-style: bold; }
.msg.-doctor .rows {
    height: auto;
    margin-top: 1;
    grid-size: 2;
    grid-columns: auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 2;
}
.msg.-doctor .rows > * { height: auto; }
.msg.-doctor .word { width: 4; text-style: bold; }
.msg.-doctor .word.-ok { color: $success; }
.msg.-doctor .word.-fail, .msg.-doctor .text.-fail { color: $error; }
.msg.-doctor .fix { color: $foreground; }

.msg.-unverified, .msg.-doctor-last { margin-top: 1; }
.msg.-unverified > .body > .heading { height: auto; }
.msg.-unverified .rows {
    height: auto;
    padding-left: 2;
    grid-size: 2;
    grid-columns: auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 3;
}
.msg.-unverified .rows > * { height: auto; }
.msg.-unverified .key { color: $muted; }
.msg.-unverified .value { color: $foreground; }

/* /config: the heading, then a bold heading row over a thin line and one row
   per value. Value and source share the room left and wrap; the other
   columns fit their words. The verified words carry the meaning, colour only
   helps. */
.msg.-config > .body > *, .msg.-entry > .body > * { height: auto; }
.msg.-config .title, .msg.-entry .title { color: $heading; text-style: bold; }
.msg.-config .rows {
    height: auto;
    margin-top: 1;
    grid-size: 5;
    grid-columns: auto 1fr auto auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 0;
}
.msg.-config .rows > * { width: 1fr; height: auto; padding-right: 2; }
.msg.-config .rows > .heading {
    height: 100%;
    color: $heading;
    text-style: bold;
    border-bottom: solid $line;
}
.msg.-config .verified.-yes, .msg.-entry .verified.-yes { color: $success; }
.msg.-config .verified.-no, .msg.-entry .verified.-no { color: $warning; }

/* /config NAME: the key, then each field's name (muted) and what it is. */
.msg.-entry .rows {
    height: auto;
    grid-size: 2;
    grid-columns: auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 2;
}
.msg.-entry .rows > * { height: auto; }
.msg.-entry .name { color: $muted; }

/* A question and its answer, kept as a record: the question muted, the
   answer blue. */
.msg.-answered > .body { color: $muted; }

/* The folders /init lists: names in one column, what goes in them in the next,
   lined up under the first line's text. */
.msg.-rows > .rows {
    height: auto;
    padding-left: 2;
    grid-size: 2;
    grid-columns: auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 2;
}
.msg.-rows .rows > * { height: auto; }

/* /compound show: the title, then each section under its heading with a blank
   row above. Field names are muted; Batches and Spectra are aligned columns.
   The last column wraps under itself. */
.msg.-card > .body > *, .msg.-history > .body > * { height: auto; }
.msg.-card .title, .msg.-card .heading, .msg.-history .title {
    color: $heading;
    text-style: bold;
}
.msg.-card .heading, .msg.-card .flag.-hint, .msg.-card .flag.-success {
    margin-top: 1;
}
.msg.-card .rows {
    height: auto;
    grid-rows: auto;
    grid-gutter: 0 2;
}
.msg.-card .rows > * { height: auto; }
.msg.-card .rows.-fields { grid-size: 2; grid-columns: auto 1fr; }
.msg.-card .rows.-fields > .name { color: $muted; }
.msg.-card .rows.-batches { grid-size: 4; grid-columns: auto auto auto 1fr; }
.msg.-card .rows.-spectra { grid-size: 3; grid-columns: auto auto 1fr; }
.msg.-card .flag > .glyph { width: 2; height: auto; text-style: bold; }
.msg.-card .flag > .text { width: 1fr; height: auto; }
.msg.-card .flag.-caution > * { color: $caution; }
.msg.-card .flag.-warning > * { color: $warning; }
.msg.-card .flag.-hint > * { color: $muted; }
.msg.-card .flag.-success > * { color: $success; }
.msg.-card .missing { padding-left: 2; }

/* /compound list: a bold heading row over a thin line, then one row per
   compound. The label column wraps; archived rows are muted. */
.msg.-table > .rows {
    height: auto;
    grid-size: 6;
    /* The label takes most of the room left; the molar mass the rest, so at
       80 columns its heading wraps before the labels squeeze. */
    grid-columns: auto 3fr auto auto auto 2fr;
    grid-rows: auto;
    grid-gutter: 0 0;
}
.msg.-table .rows > * { width: 1fr; height: auto; padding-right: 2; }
/* Every heading fills its row, so the line under them stays straight when one
   wraps. */
.msg.-table .rows > .heading {
    height: 100%;
    color: $heading;
    text-style: bold;
    border-bottom: solid $line;
}
.msg.-table .cell.-archived { color: $muted; }

/* /compound history: the title, then when (muted), what, and old → new. */
.msg.-history .rows {
    height: auto;
    grid-size: 3;
    grid-columns: auto auto 1fr;
    grid-rows: auto;
    grid-gutter: 0 2;
}
.msg.-history .rows > * { height: auto; }
.msg.-history .when { color: $muted; }

/* Bottom block: rule, input, rule, then the status line. While a question is
   open the question sits above the input and the block grows to fit it. */
#bottom {
    dock: bottom;
    height: auto;
    background: $background;
}

#bar {
    height: auto;
    padding: 0 1;
    border-top: solid $rule;
    border-bottom: solid $rule;
    border-title-align: right;
    border-title-color: $muted;
    border-title-style: none;
}

#bar.-answering {
    border-top: heavy $answer;
    border-bottom: heavy $answer;
    border-title-align: left;
    border-title-color: $answer;
    border-title-style: bold;
}

#question {
    display: none;
    height: auto;
    color: $foreground;
}
#bar.-answering > #question { display: block; }

#line { height: 1; }

#prompt {
    width: auto;
    color: $accent;
    text-style: bold;
}

#command {
    width: 1fr;
    background: $background;
    color: $echo;
}

#command:focus {
    background-tint: $foreground 0%;
}

#command > .input--placeholder,
#command > .input--suggestion { color: $faint; }
#command > .input--cursor { background: $foreground; color: $background; }
#command > .input--selection { background: $select; }

#status {
    height: 1;
    padding: 0 1;
    color: $status;
}
