# Rule zero: this repo holds the tool, never lab data, results or secrets.

# Virtual environments
.venv/
venv/
env/

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build output
build/
dist/
*.egg-info/
.eggs/

# Secrets and keys
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# SQLite databases (the compound register lives in the workspace, not here)
*.db
*.sqlite
*.sqlite3
*-journal

# Lab data: everything in data/ except the invented samples in data/samples/.
# This has to be data/* rather than data/, because git cannot un-ignore a file
# inside a folder that is ignored as a whole.
/data/*
!/data/samples/

# Operating system and editor clutter
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
