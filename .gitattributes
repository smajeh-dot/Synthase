# Store text files with Linux line endings (LF), so Windows and Linux edits
# don't make every line look changed.
* text=auto eol=lf

# Windows scripts keep Windows line endings (CRLF)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Git hooks keep LF, because Git for Windows runs them with sh
scripts/post-merge text eol=lf

# Binary files: never convert line endings or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.xls binary
*.docx binary
*.db binary
*.sqlite binary
